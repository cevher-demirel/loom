# Never upload your API key
.env

# The virtual environment -- huge, and gets rebuilt from requirements.txt
venv/

# Your actual dream archive -- personal data, and shouldn't live in a public repo
loom.db

# Python junk
__pycache__/
*.pyc

# The local embedding model cache, if sentence-transformers downloaded one here
.cache/

# Eval harness run outputs -- local results from evals/run_eval.py, not source
evals/results/

# pytest's own cache directory -- local, regenerated every run, not source
.pytest_cache/

# Ad-hoc local screenshot verification output (Stage 8 and later) -- large
# binary artifacts regenerated by scratch scripts, not source
.stage8-screenshots/
